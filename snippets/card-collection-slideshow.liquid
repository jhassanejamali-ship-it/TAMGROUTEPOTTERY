{% comment %}
  Renders a collection card with a slideshow of product featured images.

  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio: {String} Values are "adapt", "square", and "portrait"
  - columns: {Number}
  - images_per_card: {Number}
  - transition_speed: {Number} Fade duration in milliseconds
  - autoplay_interval: {Number} Autoplay interval in milliseconds
  - placeholder_image: {String} Placeholder image when collection is empty
{% endcomment %}

{%- liquid
  assign images_per_card = images_per_card | default: 3 | plus: 0
  assign transition_speed = transition_speed | default: 500 | plus: 0
  assign autoplay_interval = autoplay_interval | default: 4000 | plus: 0
  assign slide_count = 0
  assign first_slide_image = blank
  assign last_image_key = ''

  if card_collection != blank
    for product in card_collection.products
      if product.featured_image
        assign image_key = product.featured_image.src
        unless image_key == last_image_key
          assign slide_count = slide_count | plus: 1
          assign last_image_key = image_key
          if first_slide_image == blank
            assign first_slide_image = product.featured_image
          endif
          if slide_count >= images_per_card
            break
          endif
        endunless
      endif
    endfor

    if slide_count < images_per_card and card_collection.featured_image
      assign image_key = card_collection.featured_image.src
      unless image_key == last_image_key
        assign slide_count = slide_count | plus: 1
        assign last_image_key = image_key
        if first_slide_image == blank
          assign first_slide_image = card_collection.featured_image
        endif
      endunless
    endif
  endif

  assign has_media = false
  if slide_count > 0
    assign has_media = true
  endif

  assign ratio = 1
  if first_slide_image and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif first_slide_image and media_aspect_ratio == 'adapt'
    assign ratio = first_slide_image.aspect_ratio
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
  assign card_color_scheme = settings.card_color_scheme
  assign card_style = settings.card_style
  if wrapper_class == null or wrapper_class == 'none'
    assign card_color_scheme = settings.collection_card_color_scheme
    assign card_style = settings.collection_card_style
  endif
-%}

<div class="card-wrapper animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% else %}collection-card-wrapper{% endif %}">
  <div
    class="
      card
      card--{{ card_style }}
      {% if has_media %} card--media{% else %} card--text{% endif %}
      {% if card_style == 'card' %} color-{{ card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
    "
    style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  >
    <div
      class="card__inner {% if card_style == 'standard' %}color-{{ card_color_scheme }} gradient{% endif %}{% if has_media or card_style == 'standard' %} ratio{% endif %}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      {%- if slide_count > 0 -%}
        <div class="card__media">
          <collection-slideshow
            data-interval="{{ autoplay_interval }}"
            data-transition-duration="{{ transition_speed }}"
            style="--collection-slideshow-transition: {{ transition_speed }}ms;"
          >
            <div class="media media--transparent collection-slideshow__media">
              {%- assign rendered_slides = 0 -%}
              {%- assign last_image_key = '' -%}
              {%- for product in card_collection.products -%}
                {%- if product.featured_image -%}
                  {%- assign image_key = product.featured_image.src -%}
                  {%- unless image_key == last_image_key -%}
                    {%- assign rendered_slides = rendered_slides | plus: 1 -%}
                    <img
                      srcset="
                        {%- if product.featured_image.width >= 165 -%}{{ product.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                        {%- if product.featured_image.width >= 330 -%}{{ product.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                        {%- if product.featured_image.width >= 535 -%}{{ product.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                        {%- if product.featured_image.width >= 750 -%}{{ product.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if product.featured_image.width >= 1000 -%}{{ product.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                        {%- if product.featured_image.width >= 1500 -%}{{ product.featured_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {%- if product.featured_image.width >= 3000 -%}{{ product.featured_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                        {{ product.featured_image | image_url }} {{ product.featured_image.width }}w
                      "
                      src="{{ product.featured_image | image_url: width: 1500 }}"
                      sizes="
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                        (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                        calc(100vw - 3rem)
                      "
                      alt="{{ product.featured_image.alt | escape }}"
                      height="{{ product.featured_image.height }}"
                      width="{{ product.featured_image.width }}"
                      loading="lazy"
                      class="collection-slideshow__image{% if rendered_slides == 1 %} is-active{% endif %}"
                    >
                    {%- assign last_image_key = image_key -%}
                    {%- if rendered_slides >= images_per_card -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if slide_count > rendered_slides and card_collection.featured_image -%}
                {%- assign image_key = card_collection.featured_image.src -%}
                {%- unless image_key == last_image_key -%}
                  <img
                    srcset="
                      {%- if card_collection.featured_image.width >= 165 -%}{{ card_collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 330 -%}{{ card_collection.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 535 -%}{{ card_collection.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 750 -%}{{ card_collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 1000 -%}{{ card_collection.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 1500 -%}{{ card_collection.featured_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if card_collection.featured_image.width >= 3000 -%}{{ card_collection.featured_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {{ card_collection.featured_image | image_url }} {{ card_collection.featured_image.width }}w
                    "
                    src="{{ card_collection.featured_image | image_url: width: 1500 }}"
                    sizes="
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                      (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                      calc(100vw - 3rem)
                    "
                    alt="{{ card_collection.featured_image.alt | escape }}"
                    height="{{ card_collection.featured_image.height }}"
                    width="{{ card_collection.featured_image.width }}"
                    loading="lazy"
                    class="collection-slideshow__image{% if rendered_slides == 0 %} is-active{% endif %}"
                  >
                {%- endunless -%}
              {%- endif -%}
            </div>
          </collection-slideshow>
        </div>
      {%- else -%}
        {%- if card_collection == blank or slide_count == 0 -%}
          <div class="card__media">
            {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- unless card_collection == blank -%}
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading">
              <a href="{{ card_collection.url }}" class="full-unstyled-link">
                {%- if card_collection.title != blank -%}
                  {{- card_collection.title | escape -}}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
                {%- if card_collection.description == blank -%}
                  <span class="icon-wrap">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                {%- endif %}
              </a>
            </h3>
            {%- if card_collection.description != blank -%}
              <p class="card__caption">
                {{- card_collection.description | strip_html | truncatewords: 12 -}}
                <span class="icon-wrap">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- endunless -%}
    </div>
    {%- if card_collection != blank and card_style == 'card' or has_media -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading">
            <a href="{{ card_collection.url }}" class="full-unstyled-link">
              {%- if card_collection.title != blank -%}
                {{- card_collection.title | escape -}}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}
              {%- if has_media or card_collection.description == blank -%}
                <span class="icon-wrap">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              {%- endif %}
            </a>
          </h3>
        </div>
      </div>
    {%- endif -%}
    {%- if card_collection == blank -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.collection_title' | t }}
              <span class="icon-wrap">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </a>
          </h3>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
