{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-trade-enquiry-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact trade-enquiry page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">Start a Trade Enquiry</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="trade-enquiry__subheading rte">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}
    {%- liquid
      assign trade_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign trade_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'TradeEnquiryForm', class: trade_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#TradeEnquiryForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}

      <div class="trade-enquiry__fields">
        <div class="trade-enquiry__field">
          <label class="form__label" for="TradeEnquiryForm-enquiry-type">Enquiry type</label>
          <div class="select">
            <select class="select__select" id="TradeEnquiryForm-enquiry-type" name="contact[Enquiry type]">
              <option value="Request wholesale catalogue">Request wholesale catalogue</option>
              <option value="Request a quote">Request a quote</option>
              <option value="Custom production enquiry">Custom production enquiry</option>
              <option value="General trade enquiry">General trade enquiry</option>
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>

        <div class="field trade-enquiry__field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="TradeEnquiryForm-name"
            name="contact[Name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Name"
            aria-required="true"
            required
          >
          <label class="field__label" for="TradeEnquiryForm-name">
            Name <span aria-hidden="true">*</span>
          </label>
        </div>

        <div class="field field--with-error trade-enquiry__field">
          <input
            autocomplete="email"
            type="email"
            id="TradeEnquiryForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="TradeEnquiryForm-email-error"
            {% endif %}
            placeholder="Business email"
          >
          <label class="field__label" for="TradeEnquiryForm-email">
            Business email <span aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="TradeEnquiryForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>

        <div class="field trade-enquiry__field">
          <input
            type="text"
            id="TradeEnquiryForm-company"
            class="field__input"
            name="contact[Company or project name]"
            placeholder="Company or project name"
          >
          <label class="field__label" for="TradeEnquiryForm-company">Company or project name</label>
        </div>

        <div class="trade-enquiry__field">
          <label class="form__label" for="TradeEnquiryForm-business-type">Business type</label>
          <div class="select">
            <select class="select__select" id="TradeEnquiryForm-business-type" name="contact[Business type]">
              <option value="Hotel or riad">Hotel or riad</option>
              <option value="Restaurant or café">Restaurant or café</option>
              <option value="Interior designer">Interior designer</option>
              <option value="Retailer or boutique">Retailer or boutique</option>
              <option value="Homeware brand">Homeware brand</option>
              <option value="Distributor">Distributor</option>
              <option value="Other">Other</option>
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>

        <div class="field trade-enquiry__field">
          <input
            type="text"
            id="TradeEnquiryForm-country"
            class="field__input"
            name="contact[Country]"
            autocomplete="country-name"
            placeholder="Country"
          >
          <label class="field__label" for="TradeEnquiryForm-country">Country</label>
        </div>

        <div class="field trade-enquiry__field">
          <input
            type="text"
            id="TradeEnquiryForm-website"
            class="field__input"
            name="contact[Website or Instagram]"
            placeholder="Website or Instagram"
          >
          <label class="field__label" for="TradeEnquiryForm-website">Website or Instagram</label>
        </div>

        <div class="field trade-enquiry__field">
          <input
            type="tel"
            id="TradeEnquiryForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[Phone or WhatsApp]"
            placeholder="Phone or WhatsApp"
          >
          <label class="field__label" for="TradeEnquiryForm-phone">Phone or WhatsApp</label>
        </div>

        <div class="field trade-enquiry__field trade-enquiry__field--full">
          <textarea
            rows="5"
            id="TradeEnquiryForm-pieces"
            class="text-area field__input"
            name="contact[Pieces you're interested in]"
            placeholder="Pieces you're interested in"
          ></textarea>
          <label class="form__label field__label" for="TradeEnquiryForm-pieces">Pieces you're interested in</label>
        </div>

        <div class="field trade-enquiry__field trade-enquiry__field--full">
          <input
            type="text"
            id="TradeEnquiryForm-quantity"
            class="field__input"
            name="contact[Estimated quantity]"
            placeholder="Estimated quantity"
          >
          <label class="field__label" for="TradeEnquiryForm-quantity">Estimated quantity</label>
        </div>

        <div class="field trade-enquiry__field trade-enquiry__field--full">
          <textarea
            rows="8"
            id="TradeEnquiryForm-message"
            class="text-area field__input"
            name="contact[Message]"
            placeholder="Message"
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="TradeEnquiryForm-message">Message</label>
        </div>
      </div>

      <div class="contact__button">
        <button type="submit" class="button">
          Send Trade Enquiry
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Trade enquiry form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Start a Trade Enquiry",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra large"
        },
        {
          "value": "hxxl",
          "label": "Extra extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Tell us the pieces, quantities and destination country. We reply with wholesale pricing, availability and a production schedule.</p>",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Trade enquiry form"
    }
  ]
}
{% endschema %}
