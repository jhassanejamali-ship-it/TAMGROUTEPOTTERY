{% doc %}
  @prompt
    Large bold text filled with an image. Include a setting to control the background color. with shop more bootom 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
    text-align: center;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 40px;
    background-image: url('{{ block.settings.fill_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .ai-image-text-heading-placeholder-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.button_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-image-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-image-text-heading-{{ ai_gen_id }},
    .ai-image-text-heading-placeholder-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.6);
      margin-bottom: 30px;
    }

    .ai-image-text-button-{{ ai_gen_id }} {
      padding: 14px 32px;
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
    }
  }

  @media screen and (min-width: 750px) {
    .ai-image-text-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin: 0 auto;
    }
  }
{% endstyle %}

<image-filled-text-{{ ai_gen_id }}
  class="ai-image-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    {% if block.settings.fill_image %}
      <h2 class="ai-image-text-heading-{{ ai_gen_id }}">
        {{ block.settings.heading_text }}
      </h2>
    {% else %}
      <h2 class="ai-image-text-heading-placeholder-{{ ai_gen_id }}">
        {{ block.settings.heading_text }}
      </h2>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-image-text-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</image-filled-text-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Image filled text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Handcrafted Pottery"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "fill_image",
      "label": "Fill image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Fallback text color",
      "default": "#377743"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#201616"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#f9f4e9"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#377743"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image filled text"
    }
  ]
}
{% endschema %}
