    "rich_text_XiRMgR": {
      "type": "rich-text",
      "blocks": {
        "heading_nzMgaw": {
          "type": "heading",
          "settings": {
            "heading": "What Makes Tamegroute Pottery Unique?",
            "heading_size": "h1"
          }
        },
        "text_znNA9n": {
          "type": "text",
          "settings": {
            "text": "<p>Tamegroute pottery is distinguished by its signature emerald-green glaze, derived from natural manganese found only in this region. Each piece is wheel-thrown or hand-built by a single artisan, fired in a traditional wood-burning kiln, and finished with a glaze that gives every item its characteristic depth and variation. No two pieces are identical — the slight variations in color and texture are a mark of authenticity, not imperfection.</p>"
          }
        }
      },
      "block_order": [
        "heading_nzMgaw",
        "text_znNA9n"
      ],
