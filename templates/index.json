    "image_with_text_cUp9Di": {
      "type": "image-with-text",
      "blocks": {
        "heading_fG8KWq": {
          "type": "heading",
          "settings": {
            "heading": "From the Sahara to Your Home",
            "heading_size": "h1"
          }
        },
        "text_N7Pyhg": {
          "type": "text",
          "settings": {
            "text": "<p>My name is Hassane. I grew up surrounded by the emerald-green glazed pottery of Tamegroute — a small village in southern Morocco where this ancient craft has been passed down for generations. I started this store to connect you directly with the artisans who make these pieces by hand, one at a time, using the same clay and techniques used for centuries. When you buy from us, you're not buying a product — you're bringing a piece of living Moroccan heritage into your home.</p>",
            "text_style": "body"
          }
        },
        "button_DJHkk6": {
          "type": "button",
          "settings": {
            "button_label": "Meet Hassane!",
            "button_link": "shopify://pages/contact-us",
            "button_style_secondary": false
          }
